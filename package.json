{
  "name": "agy-context-studio",
  "version": "0.1.0",
  "private": false,
  "description": "Zero-token-overhead Context Window Monitor & Manager plugin for Google Antigravity.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
