{
  "command": "node",
  "args": ["server.mjs"],
  "restart_policy": "always",
  "display_name": "Context Studio",
  "description": "Zero-token-overhead live context window monitor, prompt cache diagnostics, and handoff manager.",
  "has_web_ui": true,
